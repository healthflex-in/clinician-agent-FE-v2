# Merge into .env.local for a local frontend talking to local Docker backend.
# VITE_ variables are compiled into the browser bundle; they are not secrets.
VITE_WS_URL=wss://agent-uat.example.com/ws
VITE_API_URL=https://api-uat.example.com/graphql
VITE_WS_API_KEY=required-uat-websocket-gateway-key
VITE_API_KEY=required-uat-graphql-gateway-key
FRONTEND_PORT=9000
